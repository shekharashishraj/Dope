<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:m="http://www.w3.org/1998/Math/MathML">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="styles.css">
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [['\\(','\\)'], ['$', '$']],
          displayMath: [['$$','$$']]
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
        }
      };
    </script>
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async
            src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
</head>
<body>
    <div class="exam-container">
        <header class="exam-header">
            <h1>{{ title }}</h1>
            {% if instructions %}
            <div class="instructions">
                <h2>Instructions</h2>
                <ul>
                    {% for instruction in instructions %}
                    <li>{{ instruction }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </header>

        <main class="exam-content">
            {% for section in sections %}
            <section class="section" data-section-id="{{ section.id }}" data-section-type="{{ section.type }}">
                <h2 class="section-title">{{ section.title }}</h2>
                
                {% for question in section.questions %}
                {% if section.type == 'mcq' %}
                    {% set question_id = 'mcq_q' + loop.index|string %}
                {% elif section.type == 'tf' %}
                    {% set question_id = 'tf_q' + loop.index|string %}
                {% elif section.type == 'long' %}
                    {% set question_id = 'lf_q' + loop.index|string %}
                {% else %}
                    {% set question_id = 'q' + loop.index|string %}
                {% endif %}
                <div class="question-card" data-qid="{{ question.id }}" data-qtype="{{ section.type }}" data-question-id="{{ question_id }}">
                    <div class="question-header">
                        <span class="question-number">Question {{ loop.index }}</span>
                        {% if question.meta and question.meta.marks %}
                        <span class="question-marks">({{ question.meta.marks }} marks)</span>
                        {% endif %}
                    </div>
                    
                    <div class="question-prompt">
                        {{ question.prompt|safe }}
                    </div>
                    
                    {% if section.type == 'mcq' and question.options %}
                    <div class="question-options">
                        {% for option in question.options %}
                        <div class="option" data-question-id="{{ question_id }}" data-option-id="{{ option.id }}">
                            <span class="option-label">{{ option.id }}.</span>
                            <span class="option-text">{{ option.text|safe }}</span>
                        </div>
                        {% endfor %}
                    </div>
                    {% elif section.type == 'tf' %}
                    <div class="question-options">
                        <div class="option" data-question-id="{{ question_id }}" data-value="true">
                            <span class="option-label">True</span>
                        </div>
                        <div class="option" data-question-id="{{ question_id }}" data-value="false">
                            <span class="option-label">False</span>
                        </div>
                    </div>
                    {% elif section.type == 'long' %}
                    <div class="answer-area">
                        <textarea class="long-answer" rows="10" placeholder="Type your answer here..." data-question-id="{{ question_id }}"></textarea>
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </section>
            {% endfor %}
            
            <div class="submit-container">
                <button type="button" class="submit-button" id="submit-exam">Submit Exam</button>
            </div>
        </main>
    </div>
    
    <!-- Exam Metadata -->
    <script>
        window.examMetadata = {
            subject: "{{ subject_name|default('Unknown') }}",
            examId: "{{ exam_id|default('unknown_exam') }}",
            educationLevel: "{{ education_level|default('K-12') }}",
            attackVariant: "{{ attack_variant|default('baseline') }}"
        };
    </script>
    
    <script>
        // Session initialization
        function generateUUID() {
            if (typeof crypto !== 'undefined' && crypto.randomUUID) {
                return crypto.randomUUID();
            }
            // Fallback UUID v4 generation
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                const r = Math.random() * 16 | 0;
                const v = c === 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }
        
        // Initialize exam session
        window.examSession = {
            sessionId: generateUUID(),
            startedAt: new Date().toISOString()
        };
        
        // Determine backend URL
        (function() {
            const hostname = window.location.hostname;
            const protocol = window.location.protocol;
            
            // For localhost development or file:// protocol, use explicit backend URL
            if (hostname === 'localhost' || hostname === '127.0.0.1' || protocol === 'file:') {
                window.backendUrl = 'http://localhost:8000';
            } else {
                // For production, use relative URLs (same origin)
                window.backendUrl = '';
            }
        })();
        
        // Handle option selection for MCQ and True/False questions
        document.addEventListener('DOMContentLoaded', function() {
            // Get all option elements
            const options = document.querySelectorAll('.option');
            
            options.forEach(function(option) {
                option.addEventListener('click', function() {
                    // Find the parent question card
                    const questionCard = this.closest('.question-card');
                    const questionType = questionCard.getAttribute('data-qtype');
                    
                    // Only handle selection for MCQ and TF questions
                    if (questionType === 'mcq' || questionType === 'tf') {
                        // Remove selected class from all options in this question
                        const allOptionsInQuestion = questionCard.querySelectorAll('.option');
                        allOptionsInQuestion.forEach(function(opt) {
                            opt.classList.remove('selected');
                        });
                        
                        // Add selected class to clicked option
                        this.classList.add('selected');
                    }
                });
            });
            
            // Submit button handler
            const submitButton = document.getElementById('submit-exam');
            if (submitButton) {
                submitButton.addEventListener('click', async function() {
                    try {
                        // Disable button during submission
                        submitButton.disabled = true;
                        submitButton.textContent = 'Submitting...';
                        
                        // Generate attempt ID
                        const attemptId = generateUUID();
                        const submittedAt = new Date().toISOString();
                        
                        // Calculate duration
                        const startedAt = new Date(window.examSession.startedAt);
                        const submittedAtDate = new Date(submittedAt);
                        const durationSec = Math.floor((submittedAtDate - startedAt) / 1000);
                        
                        // Collect all responses
                        const responses = [];
                        const unansweredQuestionIds = [];
                        
                        // Collect MCQ responses
                        const mcqQuestions = document.querySelectorAll('.question-card[data-qtype="mcq"]');
                        mcqQuestions.forEach(function(questionCard) {
                            const questionId = questionCard.getAttribute('data-question-id');
                            const selectedOption = questionCard.querySelector('.option.selected');
                            const marks = questionCard.querySelector('.question-marks');
                            const marksValue = marks ? parseInt(marks.textContent.match(/\d+/)?.[0] || '0') : 0;
                            
                            if (selectedOption) {
                                const optionId = selectedOption.getAttribute('data-option-id');
                                responses.push({
                                    question_id: questionId,
                                    section: "multiple_choice",
                                    type: "mcq_single",
                                    marks: marksValue,
                                    response: {
                                        selected_option_id: optionId
                                    }
                                });
                            } else {
                                unansweredQuestionIds.push(questionId);
                            }
                        });
                        
                        // Collect True/False responses
                        const tfQuestions = document.querySelectorAll('.question-card[data-qtype="tf"]');
                        tfQuestions.forEach(function(questionCard) {
                            const questionId = questionCard.getAttribute('data-question-id');
                            const selectedOption = questionCard.querySelector('.option.selected');
                            const marks = questionCard.querySelector('.question-marks');
                            const marksValue = marks ? parseInt(marks.textContent.match(/\d+/)?.[0] || '0') : 0;
                            
                            if (selectedOption) {
                                const value = selectedOption.getAttribute('data-value') === 'true';
                                responses.push({
                                    question_id: questionId,
                                    section: "true_false",
                                    type: "boolean",
                                    marks: marksValue,
                                    response: {
                                        value: value
                                    }
                                });
                            } else {
                                unansweredQuestionIds.push(questionId);
                            }
                        });
                        
                        // Collect Long Form responses
                        const lfQuestions = document.querySelectorAll('.question-card[data-qtype="long"]');
                        lfQuestions.forEach(function(questionCard) {
                            const questionId = questionCard.getAttribute('data-question-id');
                            const textarea = questionCard.querySelector('textarea.long-answer');
                            const marks = questionCard.querySelector('.question-marks');
                            const marksValue = marks ? parseInt(marks.textContent.match(/\d+/)?.[0] || '0') : 0;
                            
                            const text = textarea ? textarea.value.trim() : '';
                            responses.push({
                                question_id: questionId,
                                section: "long_form",
                                type: "text",
                                marks: marksValue,
                                response: {
                                    text: text
                                }
                            });
                            
                            if (!text) {
                                unansweredQuestionIds.push(questionId);
                            }
                        });
                        
                        // Build payload
                        const payload = {
                            schema_version: "1.0",
                            attempt: {
                                attempt_id: attemptId,
                                subject: window.examMetadata.subject,
                                exam_id: window.examMetadata.examId,
                                education_level: window.examMetadata.educationLevel,
                                started_at: window.examSession.startedAt,
                                submitted_at: submittedAt,
                                duration_sec: durationSec
                            },
                            user: {
                                user_id: "anonymous",
                                session_id: window.examSession.sessionId,
                                client: {
                                    user_agent: navigator.userAgent,
                                    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                                    locale: navigator.language
                                }
                            },
                            responses: responses,
                            validation: {
                                is_complete: unansweredQuestionIds.length === 0,
                                unanswered_question_ids: unansweredQuestionIds
                            },
                            integrityshield: {
                                attack_variant: window.examMetadata.attackVariant,
                                render_parse_gap_enabled: true
                            }
                        };
                        
                        // Submit to backend
                        const response = await fetch(`${window.backendUrl || ''}/submit_exam`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });
                        
                        if (response.ok) {
                            // Redirect to success page
                            window.location.href = `${window.backendUrl || ''}/success`;
                        } else {
                            const errorData = await response.json().catch(() => ({ message: 'Unknown error' }));
                            alert('Failed to submit exam: ' + (errorData.message || 'Please try again'));
                            submitButton.disabled = false;
                            submitButton.textContent = 'Submit Exam';
                        }
                    } catch (error) {
                        console.error('Submission error:', error);
                        alert('An error occurred while submitting. Please try again.');
                        submitButton.disabled = false;
                        submitButton.textContent = 'Submit Exam';
                    }
                });
            }
        });
    </script>
</body>
</html>

